# NinjaSubs Stremio Subtitle Addon Configuration

# Upstream Provider API Keys (Optional server-wide defaults)
# Leave the placeholders as-is unless you intend to set server-wide defaults.
# Users can also configure personal keys via the /configure web interface.
SUBDL_API_KEY=YOUR_SUBDL_API_KEY_HERE
SUBSOURCE_API_KEY=YOUR_SUBSOURCE_API_KEY_HERE
OPENSUBTITLES_API_KEY=YOUR_OPENSUBTITLES_API_KEY_HERE

# OpenSubtitles account credentials (optional).
#
# These do NOT unlock hash matching. OpenSubtitles documents search as unlimited
# and requires user authentication only for /infos/user and /download, so
# MovieHash matching already works with the API key above. What an account buys
# is the download quota: 5/day anonymous versus 20/day for a free account, and
# more for VIP. A VIP login also returns a different API host, which the
# provider then uses for subsequent requests.
#
# Supply these here for a single-user self-hosted instance. Users of a shared
# instance should enter them on the /configure page instead, where they travel
# in that user's own install URL.
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=

# Keyless scraper providers (enabled by default; no API key required)
# YIFYSubtitles is movies-only. SubtitleCat uses title-based translation search.
ENABLE_YIFYSUBTITLES=true
ENABLE_SUBTITLECAT=true

# Network & Base URL (Auto-detected if left empty)
# Set your server's domain or LAN IP if accessing from devices across home network
BASE_URL=
ADDON_BASE_URL=
HOST_IP=
LAN_IP=

# Server bind configuration
HOST=0.0.0.0
PORT=7000

# Disk Cache Directory and Storage Bounds
CACHE_DIR=subs_cache
CACHE_MAX_BYTES=1073741824
CACHE_MAX_FILES=500

# Optional Arabic subtitle autosync. Also enable Auto-Sync in the user configuration.
ENABLE_SUBTITLE_SYNC=true
ALASS_PATH=alass
ALASS_TIMEOUT_SECONDS=10
ALASS_MAX_CONCURRENT_SYNCS=1
SYNC_TOTAL_REQUEST_BUDGET=15.0
SYNC_REQUIRE_EXACT_MATCH=true
REDIS_URL=
REFERENCE_CACHE_DIR=
REFERENCE_CACHE_TTL_SECONDS=2592000

# ---------------------------------------------------------------------------
# STREMIO_PLAYBACK_WITNESS  (development / manual testing only)
# ---------------------------------------------------------------------------
# Only read by the optional `witness` compose profile:
#     docker compose --profile witness up -d --build witness
# It mounts this folder READ-ONLY into that service and nowhere else. The
# production service never receives it.
#
# Point it at the folder holding the pre-validated Alass outputs:
#     02_EVOLV_alass_output.srt
#     04_ASAP_alass_output.srt
#
# There is deliberately no usable default. Docker silently creates a missing
# bind-mount source as an EMPTY directory, so a wrong value yields a running
# witness that serves nothing. Verify with:
#     python tools/check_witness_mount.py
# WITNESS_FIXTURE_DIR=C:\Media\autosync-diagnostics
WITNESS_FIXTURE_DIR=

# ---------------------------------------------------------------------------
# AUTOSYNC_TEST_OVERRIDE  (development / manual testing only)
# ---------------------------------------------------------------------------
# Forces an already-validated Alass artifact through the ordinary production
# serve-time pipeline, so production delivery can be tested independently of the
# verifier. It is a DELIVERY experiment, never an acceptance change: no verdict,
# threshold, cache entry, or verification state is touched.
#
# Off by default. There is no route, query parameter, or user setting that turns
# it on -- only this variable. It applies to exactly two real subtitle ids and
# refuses any fixture whose digest does not match the artifact validated against
# the real Dexter S08E04 video.
#
# Set the fixture folder for the read-only /test-fixtures mount:
#     NINJASUBS_TEST_OVERRIDE_FIXTURE_DIR=C:\Media\autosync-diagnostics
#     docker compose up -d --force-recreate
#
# Look for "[AUTOSYNC_TEST_OVERRIDE] DEV/TEST override active" in the logs to
# confirm it fired. Turn it back off when the test is finished.
# ENABLE_AUTOSYNC_TEST_OVERRIDE=true
ENABLE_AUTOSYNC_TEST_OVERRIDE=false
NINJASUBS_TEST_OVERRIDE_FIXTURE_DIR=


