# NinjaSubs Stremio Subtitle Addon Configuration

# Upstream Provider API Keys (Optional server-wide defaults)
# Leave the placeholders as-is unless you intend to set server-wide defaults.
# Users can also configure personal keys via the /configure web interface.
SUBDL_API_KEY=YOUR_SUBDL_API_KEY_HERE
SUBSOURCE_API_KEY=YOUR_SUBSOURCE_API_KEY_HERE
OPENSUBTITLES_API_KEY=YOUR_OPENSUBTITLES_API_KEY_HERE

# Keyless scraper providers (enabled by default; no API key required)
# YIFYSubtitles is movies-only. SubtitleCat uses title-based translation search.
ENABLE_YIFYSUBTITLES=true
ENABLE_SUBTITLECAT=true

# Network & Base URL (Auto-detected if left empty)
# Set your server's domain or LAN IP if accessing from devices across home network
BASE_URL=
ADDON_BASE_URL=
HOST_IP=
LAN_IP=

# Server bind configuration
HOST=0.0.0.0
PORT=7000

# Disk Cache Directory and Storage Bounds
CACHE_DIR=subs_cache
CACHE_MAX_BYTES=1073741824
CACHE_MAX_FILES=500

# Optional Arabic subtitle autosync. Also enable Auto-Sync in the user configuration.
ENABLE_SUBTITLE_SYNC=true
ALASS_PATH=alass
ALASS_TIMEOUT_SECONDS=10
ALASS_MAX_CONCURRENT_SYNCS=1
SYNC_TOTAL_REQUEST_BUDGET=15.0
SYNC_REQUIRE_EXACT_MATCH=true
REDIS_URL=
REFERENCE_CACHE_DIR=
REFERENCE_CACHE_TTL_SECONDS=2592000
