# Environment variables and secrets
.env
.env.local
.env.*.local

# Persistent cache directories and subtitle payloads
subs_cache/

# Subtitle payloads are private/local-only.
# Do not publish real subtitle files, including test fixtures.
*.srt
*.vtt
*.ass
*.ssa

# Python bytecode and compiler caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
.venv/
venv/
ENV/
env/

# Test, linting, and type checking caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local databases and temporary/build artifacts
*.db
*.sqlite
*.sqlite3
*.tmp
*.bak
*.orig
*.rej
.cache/
build/
dist/

# System, IDE, and editor artifacts
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/
*.log
# Disposable local Stremio/Docker experiment transcripts (never source).
hybrid-stremio-test-logs.txt
hybrid-stremio-test2-logs.txt
# Generated container-log transcripts (ninjasubs-last*.txt). Narrowly scoped:
# no tracked source, fixture, or doc matches this prefix (verified).
ninjasubs-*.txt
# Local binary snapshots of the tree (never source, fixtures, or docs).
*.rar
Score

# Local, never-committed real-media material: the 5.4 GB source video and any
# real subtitle files kept for the owner's private production validation. The
# public corpus under tests/fixtures/large_offset/ is synthetic, so the suite
# runs without any of this; media-gated tests skip when it is absent.
# Configure with NINJASUBS_REAL_MEDIA_ROOT (see .env.example).
test-media/

# Docker auto-creates a missing bind-mount source as an empty directory;
# never let that placeholder become a committed path.
autosync-diagnostics/

# Reports emitted by the tooling (safety-mutation runs, signal calibration,
# production-path proof). Regenerated on demand by the tool that writes them,
# so they are output rather than source.
reports/
