# Environment variables and secrets
.env
.env.local
.env.*.local

# Persistent cache directories and subtitle payloads
subs_cache/
*.srt
*.vtt
*.ass
*.ssa
# Test fixtures for the large-offset gate ARE subtitle payloads and must be
# committed, otherwise the regressions they guard cannot run on a fresh clone.
# Scoped to that one directory on purpose: the golden-corpus subtitles under
# tests/fixtures/golden_sync/ are generated artifacts and stay ignored.
!tests/fixtures/large_offset/*.srt
# Hybrid reachability fixtures: the real 921-cue request reproduction needs
# the exact cached ROVERS reference bytes and the exact real ALASS output
# bytes (see tests/fixtures/hybrid_rovers/README.md). Same rationale.
!tests/fixtures/hybrid_rovers/*.srt
# The real alass outputs those tests assert against, and the fx/ input bundle
# that regenerates them (alass_out/run.sh). Same rationale as above:
# test_real_alass_outputs_are_routed_as_measured reads out_*.srt directly and
# fails on a fresh clone if the global *.srt rule swallows them.
!tests/fixtures/large_offset/alass_out/*.srt
!tests/fixtures/large_offset/alass_out/fx/*.srt
# Whiplash Golden fixtures: the real WEBRip target, the offline REMUX
# reference, and the byte-recovered live 926-cue FraMeSToR reference that the
# permanent Whiplash regression asserts against. Narrowly listed: no other
# worktree .srt is un-ignored by these lines.
!tests/fixtures/whiplash/Whiplash (2014) WEBRip.iTunes.ar(1).srt
!tests/fixtures/whiplash/Whiplash.2014.1080p.REMUX.BluRay.AVC.DTS.HD.MA.5.1-HDA(1).srt
!tests/fixtures/whiplash/whiplash-live-framestor-926.srt
# Dexter Two-Point fixtures: the real HDTV target and FraMeSToR reference
# exercised by the genuine Two-Point and hybrid routing regressions.
!tests/fixtures/two_point_sync/dexter/*.srt
# Penny Dreadful verification-input fixtures: the real HDTV target (timing-
# only cues), the Arabic and English BluRay references, and the measured ALASS
# output pinning the leniency boundary regressions.
!tests/fixtures/penny/*.srt
# Exact cached E02/E04/E05 dialogue bytes used by the shared-policy regressions.
!tests/fixtures/dialogue_alignment/**/*.srt

# Python bytecode and compiler caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
.venv/
venv/
ENV/
env/

# Test, linting, and type checking caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local databases and temporary/build artifacts
*.db
*.sqlite
*.sqlite3
*.tmp
*.bak
*.orig
*.rej
.cache/
build/
dist/

# System, IDE, and editor artifacts
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/
*.log
# Disposable local Stremio/Docker experiment transcripts (never source).
hybrid-stremio-test-logs.txt
hybrid-stremio-test2-logs.txt
# Generated container-log transcripts (ninjasubs-last*.txt). Narrowly scoped:
# no tracked source, fixture, or doc matches this prefix (verified).
ninjasubs-*.txt
# Local binary snapshots of the tree (never source, fixtures, or docs).
*.rar
Score

# Local, never-committed real-media material: the 5.4 GB source video and any
# real subtitle files kept for the owner's private production validation. The
# public corpus under tests/fixtures/large_offset/ is synthetic, so the suite
# runs without any of this; media-gated tests skip when it is absent.
# Configure with NINJASUBS_REAL_MEDIA_ROOT (see .env.example).
test-media/

# Docker auto-creates a missing bind-mount source as an empty directory;
# never let that placeholder become a committed path.
autosync-diagnostics/

# Reports emitted by the tooling (safety-mutation runs, signal calibration,
# production-path proof). Regenerated on demand by the tool that writes them,
# so they are output rather than source.
reports/
